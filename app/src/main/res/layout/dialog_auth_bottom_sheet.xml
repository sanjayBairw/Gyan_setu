<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/app_logo" />

        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Join India\'s Quiz Community"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Save your daily streak, unlock All-India rankings, and sync progress seamlessly."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Full Name Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAuthName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="Full Name / Display Name"
            app:startIconDrawable="@drawable/ic_person">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAuthName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:text="Aspirant" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Target Goal / Class / Exam -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Select Your Preparation Goal"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGoals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalJee"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JEE Main &amp; Advanced" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalCbse10"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="CBSE Class 10" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalCbse12"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CBSE Class 12" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalRbse10"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RBSE Class 10" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalRbse12"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RBSE Class 12" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalSchool"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="School (Class 1-9)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalCompetitive"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UPSC / SSC / Govt" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGoalGeneral"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily GK &amp; General" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Method 1: Google Sign In -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthGoogle"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:text="Continue with Google"
            android:textColor="@color/text_primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:strokeColor="@color/surface_stroke" />

        <!-- Method 2: Phone / Mobile OTP -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthPhone"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="Sign In with Mobile OTP"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_phone"
            app:iconGravity="textStart" />

        <!-- Method 3: Continue as Guest -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthGuest"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Continue as Guest (No Login Required)"
            android:textColor="@color/text_secondary" />

    </LinearLayout>
</ScrollView>
